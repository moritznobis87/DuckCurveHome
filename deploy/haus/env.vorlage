# Duck Curve Home auf dem Hausgeraet - Einstellungen.
#
# einrichten.sh legt daraus /opt/duckcurve/.env an und setzt dabei alle Werte, die hier als
# @ZUFALL@ stehen, auf frische Zufallswerte. Eine vorhandene .env wird nie ueberschrieben.
# Nach einer Aenderung: `dch neustart`.
#
# Die Werte unter "Von Railway uebernehmen" stehen heute in den Variablen der Railway-Dienste
# (api bzw. web) und werden von dort abgeschrieben.

# --- Geraet -------------------------------------------------------------------------------------
# Name im Netz: Die Oberflaeche ist dann unter https://<name>.local erreichbar.
DCH_HOSTNAME=duckcurve-home
# Welche Images: `main` folgt dem Stand von main (wird bei jedem Push gebaut), `v1.2.3` bleibt auf
# einer Version stehen. `dch aktualisieren <version>` setzt den Wert und zieht die Images.
DCH_VERSION=main

# --- Datenbank ----------------------------------------------------------------------------------
POSTGRES_PASSWORD=@ZUFALL@
# Speicher fuer Postgres; die Vorgaben passen fuer 4 bis 8 GB.
# PG_SHARED_BUFFERS=512MB
# PG_EFFECTIVE_CACHE_SIZE=2GB

# --- Zugang -------------------------------------------------------------------------------------
# Bearer zwischen Oberflaeche und API (nur innerhalb des Geraets).
DCH_API_TOKEN=@ZUFALL@
# Token der Bridge. Derselbe Wert gehoert in Home Assistant in die Option `api_token` des
# Bridge-Add-ons. `dch koppeln` zeigt ihn an.
DCH_BRIDGE_TOKENS=@ZUFALL@
# Signiert die Sitzungscookies der Oberflaeche (mindestens 32 Zeichen). Ein neuer Wert meldet alle
# gekoppelten Geraete ab.
DCH_SESSION_SECRET=@ZUFALL@
# Pairing-Token fuer neue Anzeigegeraete: https://<name>.local/pair?token=...&name=iPad-Flur
DCH_KIOSK_TOKEN=@ZUFALL@
# Pairing-Token fuer Gaeste (nur lesen); leer lassen, solange niemand eingeladen ist.
DCH_GUEST_TOKEN=
# DCH_GUEST_HOURS=24
# Adresse fuer die Pairing-Links auf der Seite "Zugang und Sicherung". Leer: der Host der Anfrage.
DCH_PUBLIC_HOST=

# --- Von Railway uebernehmen (Dienst api) ------------------------------------------------------
DCH_TIBBER_TOKEN=
DCH_TIBBER_HOME_ID=
DCH_MYENERGI_SERIAL=
DCH_MYENERGI_API_KEY=
DCH_INEXOGY_EMAIL=
DCH_INEXOGY_PASSWORD=
DCH_INEXOGY_METER=
# DCH_CONFIG_FILE=
# Absender der Mitteilungen; leer gelassen gilt die Vorgabe des Dienstes (CONFIGURATION.md).
# DCH_PUSH_SUBJECT=
DCH_ACTUATION_ENABLED=true
# Selbsttaetiges Stellen der Waermepumpenanforderung. Geschaltet wird ohnehin nur ueber die Bridge:
# Solange sie mit Railway verbunden ist, schaltet dieses Geraet nichts.
DCH_HEAT_PUMP_ACTUATION_ENABLED=true

# Mitteilungen an die iOS-App (apps/ios/README.md). Der Schluessel als eine Zeile in doppelten
# Anfuehrungszeichen, Zeilenumbrueche als \n.
DCH_APNS_KEY_P8=
DCH_APNS_KEY_ID=
DCH_APNS_TEAM_ID=
# DCH_APNS_TOPIC=home.duckcurve.app

# Alfred mit Sprachmodell (docs/ALFRED.md). Leer: Alfred bleibt bei vorbereiteten Texten.
DCH_ALFRED_SCHLUESSEL=
# DCH_ALFRED_ANBIETER=mistral

# --- Zugang von unterwegs (optional) ------------------------------------------------------------
# Cloudflare Tunnel: Token aus Cloudflare Zero Trust -> Networks -> Tunnels. DCH_FERNZUGANG=1
# startet den Dienst `cloudflared` mit.
DCH_FERNZUGANG=0
CLOUDFLARE_TUNNEL_TOKEN=

# --- Sicherung ----------------------------------------------------------------------------------
# Wie viele naechtliche Sicherungen auf dem Geraet bleiben.
DCH_SICHERUNG_BEHALTEN=14
# Optional eine Kopie ausser Haus mit rclone, z. B. "r2:duckcurve-sicherung". Das rclone-Ziel wird
# vorher mit `rclone config` eingerichtet (README, Schritt 8).
DCH_SICHERUNG_ZIEL=
