# Duck Curve Home – Umgebungsvariablen (Phase 1). Kopieren nach .env; niemals Secrets einchecken.

# --- API / Worker ---------------------------------------------------------------------------
DCH_MODE=demo                 # demo | live (Phase 2)
DCH_ROLE=all                  # all | api | worker
DCH_HOST=0.0.0.0
DCH_PORT=8000
DCH_LOG_LEVEL=INFO
DCH_CORS_ORIGINS=["http://localhost:3000"]
DCH_TICK_S=10                 # Regler-Takt in Simulationssekunden
DCH_HISTORY_RETENTION_HOURS=72

# Demo-Modus
DCH_DEMO_SPEED=1              # Simulationssekunden je Echtzeitsekunde; 288 = 24 h in 5 min
DCH_DEMO_SEED=7
# DCH_DEMO_START=2026-09-04T06:00:00Z
DCH_DEMO_WARMUP_HOURS=30

# --- Web -------------------------------------------------------------------------------------
DCH_API_URL=http://localhost:8000

# --- Live-Modus (Phase 2) ---------------------------------------------------------------------
# DCH_MODE=live
# DATABASE_URL=postgresql://user:***@host:5432/db      # Railway-Referenz; asyncpg wird automatisch gesetzt
# DCH_BRIDGE_TOKENS=["<openssl rand -hex 32>"]
# DCH_API_TOKEN=<openssl rand -hex 32>
# DCH_TIBBER_TOKEN=
# DCH_CONFIG_FILE=config/hems.yaml
# DCH_ACTUATION_ENABLED=true            # Lichter und Kaffeemaschine über das Dashboard schalten
# DCH_HEAT_PUMP_ACTUATION_ENABLED=false # K1 selbsttätig stellen – erst mit Wächter und Auto-Off-Timer

# --- Web (Kiosk-Anmeldung) ------------------------------------------------------------------
# DCH_SESSION_SECRET=<mind. 32 Zeichen>
# DCH_KIOSK_TOKEN=<Pairing-Token>

# --- Bridge (lokal; im Add-on setzt run.sh diese Werte) ---------------------------------------
# DCH_BRIDGE_HA_WS_URL=ws://homeassistant.local:8123/api/websocket
# SUPERVISOR_TOKEN=<Long-Lived Access Token bei lokalem Betrieb>
# DCH_BRIDGE_API_WS_URL=ws://localhost:8000/bridge/ws
# DCH_BRIDGE_API_TOKEN=
# DCH_BRIDGE_ENTITIES_FILE=./entities.yaml
