# Duck Curve Home – Umgebungsvariablen (Phase 1). Kopieren nach .env; niemals Secrets einchecken.

# --- API / Worker ---------------------------------------------------------------------------
DCH_MODE=demo                 # demo | live (Phase 2)
DCH_ROLE=all                  # all | api | worker
DCH_HOST=0.0.0.0
DCH_PORT=8000
DCH_LOG_LEVEL=INFO
DCH_CORS_ORIGINS=["http://localhost:3000"]
DCH_TICK_S=10                 # Regler-Takt in Simulationssekunden
DCH_HISTORY_RETENTION_HOURS=72

# Demo-Modus
DCH_DEMO_SPEED=1              # Simulationssekunden je Echtzeitsekunde; 288 = 24 h in 5 min
DCH_DEMO_SEED=7
# DCH_DEMO_START=2026-09-04T06:00:00Z
DCH_DEMO_WARMUP_HOURS=30

# --- Web -------------------------------------------------------------------------------------
DCH_API_URL=http://localhost:8000

# --- Phase 2 (vorgesehen, noch ohne Wirkung) -------------------------------------------------
# DATABASE_URL=postgresql+asyncpg://dch:***@postgres:5432/dch
# DCH_TIBBER_TOKEN=
# DCH_HA_URL=                  # Home-Assistant-Basis-URL (lokal oder Nabu Casa)
# DCH_HA_TOKEN=                # Long-Lived Access Token
