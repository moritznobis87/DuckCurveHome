# Duck Curve Home - Umgebungsvariablen (Phase 1). Kopieren nach .env; niemals Secrets einchecken.

# --- API / Worker ---------------------------------------------------------------------------
DCH_MODE=demo                 # demo | live (Phase 2)
DCH_ROLE=all                  # all | api | worker
DCH_HOST=0.0.0.0
DCH_PORT=8000
DCH_LOG_LEVEL=INFO
DCH_CORS_ORIGINS=["http://localhost:3000"]
DCH_TICK_S=10                 # Regler-Takt in Simulationssekunden
DCH_HISTORY_RETENTION_HOURS=72

# Demo-Modus
DCH_DEMO_SPEED=1              # Simulationssekunden je Echtzeitsekunde; 288 = 24 h in 5 min
DCH_DEMO_SEED=7
# DCH_DEMO_START=2026-09-04T06:00:00Z
DCH_DEMO_WARMUP_HOURS=30

# --- Web -------------------------------------------------------------------------------------
DCH_API_URL=http://localhost:8000

# --- Live-Modus (Phase 2) ---------------------------------------------------------------------
# DCH_MODE=live
# DATABASE_URL=postgresql://user:***@host:5432/db      # Railway-Referenz; asyncpg wird automatisch gesetzt
# DCH_BRIDGE_TOKENS=["<openssl rand -hex 32>"]
# DCH_API_TOKEN=<openssl rand -hex 32>
# DCH_TIBBER_TOKEN=
# DCH_CONFIG_FILE=config/hems.yaml
# DCH_ACTUATION_ENABLED=true            # Lichter und Kaffeemaschine über das Dashboard schalten
# DCH_HEAT_PUMP_ACTUATION_ENABLED=true  # K1 selbsttätig stellen; seit 09.11.2026 Vorgabe. Auf
#                                       # false bleibt die Regelung im Schatten: entscheiden ja,
#                                       # schalten nein. E0 (Auto-Off im Relais) und E1 (Wächter
#                                       # in Home Assistant) sind dann die einzigen Rückfallebenen

# --- Alfred, der Helfer (docs/ALFRED.md) ------------------------------------------------------
# Ohne Schluessel bleibt Alfred bei vorbereiteten Texten. Mit Schluessel beantwortet er Fragen zu
# den Daten des Hauses; dafuer gehen Zahlen (keine Alarm-, Tuer- oder Standortdaten) an den Anbieter.
# DCH_ALFRED_SCHLUESSEL=
# DCH_ALFRED_ANBIETER=mistral          # oder openai; weitere kompatible ueber DCH_ALFRED_URL
# DCH_ALFRED_MODELL=                   # leer = mistral-medium-latest
# DCH_ALFRED_FRAGEN_PRO_TAG=100

# --- Anmeldung mit Passkey (docs/ZUGANG.md, ADR-0002) ----------------------------------------
# Die RP-ID ist die registrierbare Domain und spaeter NICHT mehr aenderbar: ein Wechsel entwertet
# jeden Passkey. In der Entwicklung localhost - der Browser nimmt ihn auch ohne https als
# sicheren Kontext.
# DCH_PASSKEY_RP_ID=duckcurve.de
# DCH_PASSKEY_HERKUENFTE=["https://home.duckcurve.de"]
# DCH_SITZUNG_TAGE=30                  # Frist einer Personensitzung
# DCH_ZUGANGSTOKEN_STUNDEN=72          # Frist eines Einladungslinks
# DCH_ANMELDE_URL=https://home.duckcurve.de   # leer = erste Herkunft; Adresse im Einladungslink
#
# Entwicklung:
# DCH_PASSKEY_RP_ID=localhost
# DCH_PASSKEY_HERKUENFTE=["http://localhost:3000"]

# --- Einladung per E-Mail (dch_api/post.py) --------------------------------------------------
# Ohne diese Angaben wird nichts verschickt; der Einladungslink bleibt auf der Seite „Zugang"
# zum Kopieren. Ist beides eingetragen, gilt SMTP.
# DCH_SMTP_HOST=
# DCH_SMTP_PORT=587
# DCH_SMTP_BENUTZER=
# DCH_SMTP_PASSWORT=
# DCH_SMTP_SICHERHEIT=starttls         # starttls | ssl | keine
# DCH_RESEND_SCHLUESSEL=               # HTTPS-Versender, wenn ausgehendes SMTP gesperrt ist
# DCH_ABSENDER=haus@example.org        # leer = DCH_SMTP_BENUTZER

# --- Web (Geraetepaarung und Anmeldezwang) ---------------------------------------------------
# DCH_SESSION_SECRET=<mind. 32 Zeichen>   # signiert das Geraetecookie; macht die Paarung moeglich
# DCH_KIOSK_TOKEN=<Pairing-Token>
# DCH_GUEST_TOKEN=<Pairing-Token fuer Gaeste>
# DCH_ANMELDUNG=1                      # Anmeldung verlangen, auch ohne Geraetepaarung

# --- Bridge (lokal; im Add-on setzt run.sh diese Werte) ---------------------------------------
# DCH_BRIDGE_HA_WS_URL=ws://homeassistant.local:8123/api/websocket
# SUPERVISOR_TOKEN=<Long-Lived Access Token bei lokalem Betrieb>
# DCH_BRIDGE_API_WS_URL=ws://localhost:8000/bridge/ws
# DCH_BRIDGE_API_TOKEN=
# DCH_BRIDGE_ENTITIES_FILE=./entities.yaml
